<Application x:Class="Parazs.Szemelyzet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Foablak.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Papir" Color="#F8F4EB"/>
    <SolidColorBrush x:Key="Feher" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="Tinta" Color="#2B221E"/>
    <SolidColorBrush x:Key="Halvany" Color="#665A51"/>
    <SolidColorBrush x:Key="Vonal" Color="#E4DACE"/>
    <SolidColorBrush x:Key="Rozsda" Color="#963319"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
      <Setter Property="Background" Value="{StaticResource Feher}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vonal}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="KiemeltGomb" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Rozsda}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rozsda}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vonal}"/>
      <Setter Property="Background" Value="{StaticResource Feher}"/>
      <Setter Property="MinHeight" Value="35"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vonal}"/>
      <Setter Property="Background" Value="{StaticResource Feher}"/>
      <Setter Property="MinHeight" Value="35"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="36"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Vonal}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vonal}"/>
      <Setter Property="Background" Value="{StaticResource Feher}"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Resources>
</Application>
